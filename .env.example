# Database Configuration
# =====================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/A0
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme_in_production
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA Configuration
# =================
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Redis Configuration
# ===================
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# File Upload Settings
# ====================
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10GB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=11GB

# GraphQL Configuration
# =====================
SPRING_GRAPHQL_GRAPHIQL_ENABLED=true
SPRING_GRAPHQL_SCHEMA_INTROSPECTION_ENABLED=true

# Management & Monitoring
# =======================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# Server Configuration
# ====================
SERVER_ADDRESS=0.0.0.0

# Video & Photo Processing
# ========================
VIDEO_PATH=src/main/resources/video/
VIDEO_FFMPEG=/usr/bin/ffmpeg
VIDEO_FFPROBE=/usr/bin/ffprobe
PHOTO_PATH=src/main/resources/photo/

# Security Configuration (CHANGE IN PRODUCTION!)
# ===============================================
JWT_SECRET_KEY=change_this_to_a_strong_secret_key_in_production
CUSTOM_KEY=change_this_api_key_in_production

